<mxfile host="app.diagrams.net" agent="p4-ladder" version="24.0.0">
  <diagram id="ladder" name="Necessity Ladder">
    <mxGraphModel dx="900" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== column headers ===== -->
        <mxCell id="hdrQ" value="rung: the capability it isolates" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="380" height="22" as="geometry" />
        </mxCell>
        <mxCell id="hdrV" value="verdict (wiki / cluster50)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="8" width="250" height="22" as="geometry" />
        </mxCell>

        <!-- ===== r1 : timing ceiling (green) ===== -->
        <mxCell id="q1" value="&lt;b&gt;r1&lt;/b&gt; timing ceiling&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Is the corridor a timing problem at all?&lt;/i&gt;&lt;br&gt;Oracle controls only &lt;i&gt;when&lt;/i&gt;, over the predictor's own objects.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;yes, in principle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;95.8% / 91.2% of corridor&lt;br&gt;(cluster53: 7.3% &amp;rarr; exits study)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r2 : arbitration (red) ===== -->
        <mxCell id="q2" value="&lt;b&gt;r2&lt;/b&gt; arbitration&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Must fetches be chosen as a set?&lt;/i&gt;&lt;br&gt;Optimal joint chooser vs per-candidate threshold.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="126" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;no: separable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+0.01 / &amp;minus;0.01 pts&lt;br&gt;learned arbitration unnecessary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="126" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q2" target="q3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r3 : offered stream (red) ===== -->
        <mxCell id="q3" value="&lt;b&gt;r3&lt;/b&gt; the offered stream&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Can re-timing what the baseline emits win?&lt;/i&gt;&lt;br&gt;Perfect timing, candidates restricted to the k=1 stream.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="212" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;no: below baseline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;minus;7.01 / &amp;minus;10.82 pts&lt;br&gt;&amp;rArr; the problem is &lt;b&gt;coverage&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="212" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q3" target="q4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r4 : coverage (green) ===== -->
        <mxCell id="q4" value="&lt;b&gt;r4&lt;/b&gt; coverage&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Does breadth plus perfect insertion reach it?&lt;/i&gt;&lt;br&gt;Fan-out 32, no confidence floor, insert just before use.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="298" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;yes: target exists&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+10.41 [8.74, 12.08] / +11.42 [9.95, 12.91]&lt;br&gt;clears the pre-registered bar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="298" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q4" target="q5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r5 : emission-time fetch (red) ===== -->
        <mxCell id="q5" value="&lt;b&gt;r5&lt;/b&gt; emission-time fetch&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Is just-in-time insertion necessary?&lt;/i&gt;&lt;br&gt;r4's selection and a &lt;i&gt;perfect&lt;/i&gt; forecaster, fetching at prediction time.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="384" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="&lt;b&gt;yes, JIT is required&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+0.62 / &amp;minus;3.07 pts (&amp;le;6% of corridor)&lt;br&gt;a perfect forecaster cannot rescue it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="384" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q5" target="q6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r6 : causal placement (red) ===== -->
        <mxCell id="q6" value="&lt;b&gt;r6&lt;/b&gt; causal placement&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Can a causal model place the insertion?&lt;/i&gt;&lt;br&gt;r4's coverage; only the clock becomes causal (learned hazard).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="&lt;b&gt;no: rank-learnable, not placeable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;minus;40.06 / &amp;minus;26.01 pts&lt;br&gt;passes learnability (&amp;rho;=0.60/0.43, AUC 0.92/0.81)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q6" target="mech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== mechanism band ===== -->
        <mxCell id="mech" value="&lt;b&gt;mechanism: endogenous slack&lt;/b&gt; &amp;nbsp;&amp;middot;&amp;nbsp; the policy's own low-precision volume evicts its future targets, so S(100) falls 1.00 &amp;rarr; 0.05 and the window the timing model must hit is set by the policy, not the workload" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="556" width="650" height="46" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="mech" target="q7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== r7 : CGP (red) ===== -->
        <mxCell id="q7" value="&lt;b&gt;r7&lt;/b&gt; corroboration-gated prefetch&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Can coverage be bought without volume?&lt;/i&gt;&lt;br&gt;Byte-free watchlist arms candidates; a tight predictor fires.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="622" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="&lt;b&gt;no: signal is redundant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;minus;7.60 / &amp;minus;5.39 pts&lt;br&gt;armed share 43%&amp;rarr;69%, precision flat at 0.268&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="622" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1.5;" edge="1" parent="1" source="q7" target="cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== certificate ===== -->
        <mxCell id="cert" value="&lt;b&gt;certificate: TRAP&lt;/b&gt; &amp;nbsp;&amp;middot;&amp;nbsp; the corridor is real (r1, r4) but reachable only with foresight; every all-causal combination lies below the tuned baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;spacingRight=10;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="708" width="650" height="42" as="geometry" />
        </mxCell>

        <!-- ===== legend ===== -->
        <mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="30" y="766" width="18" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" value="clairvoyant check: certifies the corridor reachable in principle" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="54" y="764" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="766" width="18" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lg2t" value="negative: this capability does not close the gap" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="424" y="764" width="270" height="18" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
